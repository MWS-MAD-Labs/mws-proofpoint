# ===========================================
# ProofPoint Dashboard - Environment Variables
# ===========================================

# ===========================================
# Database (PostgreSQL)
# ===========================================
# Local app-to-db connection (non-docker local dev)
DATABASE_URL=postgresql://proofpoint:your-secure-password@localhost:5432/proofpoint
# Docker/compose-friendly DB vars
POSTGRES_HOST=postgres
# Host port published by Docker Compose for non-containerized local development
POSTGRES_HOST_PORT=5432
# PostgreSQL port used inside the Compose network
POSTGRES_PORT=5432
POSTGRES_DB=proofpoint
POSTGRES_USER=proofpoint
POSTGRES_PASSWORD=your-secure-password

# ===========================================
# NextAuth.js
# ===========================================
# Keep set to "nextauth" until Central and Hub are configured and staging is verified.
PROOFPOINT_AUTH_MODE=nextauth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-key-min-32-chars
AUTH_TRUST_HOST=true
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# MWS Hub shared session and Central entitlement.
# Set PROOFPOINT_AUTH_MODE=hub only after ProofPoint is registered in Central and Hub.
HUB_BASE_URL=https://app.mws.web.id
HUB_SSO_APP_ID=proofpoint
HUB_ACCESS_AUDIENCE=mws-apps
HUB_ACCESS_COOKIE_NAME=
CENTRAL_API_BASE_URL=https://db.mws.web.id/api/internal
CENTRAL_API_TOKEN=
CENTRAL_ORGANIZATION_ID=
PROOFPOINT_CENTRAL_ACCESS_CACHE_SECONDS=30
# How often ProofPoint checks Central for account changes (seconds; 0 turns the sync off, minimum 15)
PROOFPOINT_CENTRAL_SYNC_SECONDS=60

# ===========================================
# MinIO S3 Storage
# ===========================================
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=evidence

# ===========================================
# Email Service Configuration
# ===========================================
# Gmail API with a service account and Workspace domain-wide delegation.
EMAIL_PROVIDER=gmail
GMAIL_SENDER_EMAIL=no-reply@example.org
GMAIL_SENDER_NAME=ProofPoint Notifications
Proofpoint_GMAIL_CREDENTIALS_FILE=secret/gmail-service-account.json
# Alternatively, provide the service-account JSON itself or its base64 encoding.
GMAIL_CREDENTIALS_JSON=

# Master delivery switch. Keep false until credentials and delegation are ready.
EMAIL_ENABLED=false
EMAIL_DEBUG=false

# SMTP fallback. Set EMAIL_PROVIDER=smtp to use these values.
EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME=ProofPoint Dashboard
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password


# Legacy Supabase (to be removed after migration)
NEXT_PUBLIC_SUPABASE_PROJECT_ID=mpnbpcegassmvshsahbp
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_URL=https://mpnbpcegassmvshsahbp.supabase.co
