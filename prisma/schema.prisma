  CLASSROOM_OBSERVATION
  GENERIC
  STAFF_APPRAISAL
}

enum WorkflowActionType {
  FILL_FORM
  ACKNOWLEDGE
  REVIEW
  APPROVE
}

enum IndicatorQuestionType {
