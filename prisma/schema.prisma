generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Department {
  id                   String                @id @default(dbgenerated("gen_random_uuid()"))
  name                 String
  parentId             String?               @map("parent_id")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @default(now()) @map("updated_at")
  departmentRoles      DepartmentRole[]
  parent               Department?           @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children             Department[]          @relation("DepartmentHierarchy")
  profiles             Profile[]
  programCollaborators ProgramCollaborator[]
  rubricTemplates      RubricTemplate[]
  strategicPlan        StrategicPlan?

  @@index([parentId])
  @@map("departments")
}

model User {
  id                      String                  @id @default(dbgenerated("gen_random_uuid()"))
  email                   String                  @unique
  passwordHash            String                  @map("password_hash")
  emailVerified           Boolean                 @default(false) @map("email_verified")
  status                  UserStatus              @default(active)
  createdAt               DateTime                @default(now()) @map("created_at")
  updatedAt               DateTime                @default(now()) @map("updated_at")
  nlsmartrack_id          String?
  askedQuestions          AssessmentQuestion[]    @relation("AskedQuestions")
  answeredQuestions       AssessmentQuestion[]    @relation("AnsweredQuestions")
  directorAssessments     Assessment[]            @relation("DirectorAssessments")
  managerAssessments      Assessment[]            @relation("ManagerAssessments")
  returnedAssessments     Assessment[]            @relation("ReturnedAssessments")
  assessments             Assessment[]            @relation("StaffAssessments")
  notificationPreferences NotificationPreference?
  notifications           Notification[]
  observationUpdates      ObservationUpdate[]     @relation("ObservationUpdateAuthor")
  managedObservations     Observation[]           @relation("ManagerObservations")
  observations            Observation[]           @relation("StaffObservations")
  profile                 Profile?
  progressUpdates         ProgramProgressUpdate[] @relation("ProgressUpdateAuthor")
  createdTemplates        RubricTemplate[]        @relation("TemplateCreator")
  ownedStrategicPlans     StrategicPlan[]         @relation("PlanOwner")
  roles                   UserRole[]

  @@index([status])
  @@map("users")
}

model Profile {
  id               String      @id @default(dbgenerated("gen_random_uuid()"))
  userId           String      @unique @map("user_id")
  email            String
  fullName         String?     @map("full_name")
  niy              String?
  jobTitle         String?     @map("job_title")
  departmentId     String?     @map("department_id")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @default(now()) @map("updated_at")
  migration_source String?
  department       Department? @relation(fields: [departmentId], references: [id])
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([departmentId])
  @@map("profiles")
}

model UserRole {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  userId    String   @map("user_id")
  role      AppRole  @default(staff)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
  @@map("user_roles")
}

model RubricTemplate {
  id                  String                   @id @default(dbgenerated("gen_random_uuid()"))
  name                String
  description         String?
  departmentId        String?                  @map("department_id")
  isGlobal            Boolean                  @default(false) @map("is_global")
  createdById         String?                  @map("created_by")
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @default(now()) @map("updated_at")
  templateType        TemplateType             @default(KPI_APPRAISAL) @map("template_type")
  isActive            Boolean                  @default(true) @map("is_active")
  assessments         Assessment[]
  departmentRoles     DepartmentRole[]
  domains             KpiDomain[]
  kpi_standards       KpiStandard[]
  kpis                Kpi[]
  observations        Observation[]
  workflowAssignments RoleWorkflowAssignment[]
  sections            RubricSection[]
  createdBy           User?                    @relation("TemplateCreator", fields: [createdById], references: [id])
  department          Department?              @relation(fields: [departmentId], references: [id])

  @@map("rubric_templates")
}

model RubricSection {
  id         String            @id @default(dbgenerated("gen_random_uuid()"))
  templateId String            @map("template_id")
  name       String
  weight     Decimal?          @db.Decimal(5, 2)
  sortOrder  Int               @default(0) @map("sort_order")
  createdAt  DateTime          @default(now()) @map("created_at")
  indicators RubricIndicator[]
  template   RubricTemplate    @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@map("rubric_sections")
}

model RubricIndicator {
  id               String                @id @default(dbgenerated("gen_random_uuid()"))
  sectionId        String                @map("section_id")
  name             String
  description      String?
  sortOrder        Int                   @default(0) @map("sort_order")
  evidenceGuidance String?               @map("evidence_guidance")
  scoreOptions     Json?                 @map("score_options")
  createdAt        DateTime              @default(now()) @map("created_at")
  questionType     IndicatorQuestionType @default(SCALE) @map("question_type")
  scoreMin         Int?                  @map("score_min")
  scoreMax         Int?                  @map("score_max")
  scoreStep        Int?                  @map("score_step")
  placeholderText  String?               @map("placeholder_text")
  questions        AssessmentQuestion[]
  answers          ObservationAnswer[]
  section          RubricSection         @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@map("rubric_indicators")
}

model KpiDomain {
  id         String         @id @default(dbgenerated("gen_random_uuid()"))
  templateId String         @map("template_id")
  name       String
  weight     Decimal        @default(0) @db.Decimal(5, 2)
  sortOrder  Int            @default(0) @map("sort_order")
  createdAt  DateTime       @default(now()) @map("created_at")
  code       String
  legacyCode String?        @map("legacy_code")
  template   RubricTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  standards  KpiStandard[]

  @@unique([templateId, code])
  @@index([templateId])
  @@map("kpi_domains")
}

model KpiStandard {
  id               String         @id @default(dbgenerated("gen_random_uuid()"))
  domainId         String         @map("domain_id")
  name             String
  sortOrder        Int            @default(0) @map("sort_order")
  createdAt        DateTime       @default(now()) @map("created_at")
  code             String
  legacyCode       String?        @map("legacy_code")
  templateId       String         @map("template_id")
  domain           KpiDomain      @relation(fields: [domainId], references: [id], onDelete: Cascade)
  rubric_templates RubricTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  kpis             Kpi[]

  @@unique([templateId, code])
  @@index([domainId])
  @@index([templateId])
  @@map("kpi_standards")
}

model Kpi {
  id               String           @id @default(dbgenerated("gen_random_uuid()"))
  standardId       String           @map("standard_id")
  name             String
  description      String?
  evidenceGuidance String?          @map("evidence_guidance")
  trainings        String?
  sortOrder        Int              @default(0) @map("sort_order")
  rubric4          String           @map("rubric_4")
  rubric3          String           @map("rubric_3")
  rubric2          String           @map("rubric_2")
  rubric1          String           @map("rubric_1")
  createdAt        DateTime         @default(now()) @map("created_at")
  code             String
  legacyCode       String?          @map("legacy_code")
  templateId       String           @map("template_id")
  standard         KpiStandard      @relation(fields: [standardId], references: [id], onDelete: Cascade)
  rubric_templates RubricTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  programLinks     ProgramKpiLink[]

  @@unique([templateId, code])
  @@index([standardId])
  @@index([templateId])
  @@map("kpis")
}

model Assessment {
  id                 String               @id @default(dbgenerated("gen_random_uuid()"))
  staffId            String               @map("staff_id")
  managerId          String?              @map("manager_id")
  directorId         String?              @map("director_id")
  templateId         String?              @map("template_id")
  period             String
  status             AssessmentStatus
  staffScores        Json                 @default("{}") @map("staff_scores")
  managerScores      Json                 @default("{}") @map("manager_scores")
  staffEvidence      Json                 @default("{}") @map("staff_evidence")
  managerEvidence    Json                 @default("{}") @map("manager_evidence")
  managerNotes       String?              @map("manager_notes")
  directorComments   String?              @map("director_comments")
  returnFeedback     String?              @map("return_feedback")
  returnedAt         DateTime?            @map("returned_at")
  returnedById       String?              @map("returned_by")
  finalScore         Decimal?             @map("final_score") @db.Decimal(4, 2)
  finalGrade         String?              @map("final_grade")
  staffSubmittedAt   DateTime?            @map("staff_submitted_at")
  managerReviewedAt  DateTime?            @map("manager_reviewed_at")
  directorApprovedAt DateTime?            @map("director_approved_at")
  staffNotes         String?              @map("staff_notes")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @default(now()) @map("updated_at")
  nlsmartrack_id     String?
  questions          AssessmentQuestion[]
  director           User?                @relation("DirectorAssessments", fields: [directorId], references: [id])
  manager            User?                @relation("ManagerAssessments", fields: [managerId], references: [id])
  returnedBy         User?                @relation("ReturnedAssessments", fields: [returnedById], references: [id])
  staff              User                 @relation("StaffAssessments", fields: [staffId], references: [id], onDelete: Cascade)
  template           RubricTemplate?      @relation(fields: [templateId], references: [id])
  notifications      Notification[]

  @@index([staffId])
  @@index([managerId])
  @@index([directorId])
  @@index([status])
  @@index([returnedById])
  @@map("assessments")
}

model AssessmentQuestion {
  id              String           @id @default(dbgenerated("gen_random_uuid()"))
  assessmentId    String           @map("assessment_id")
  indicatorId     String?          @map("indicator_id")
  askedBy         String           @map("asked_by")
  question        String
  response        String?
  respondedById   String?          @map("responded_by")
  respondedAt     DateTime?        @map("responded_at")
  status          QuestionStatus
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @default(now()) @map("updated_at")
  askedByUser     User             @relation("AskedQuestions", fields: [askedBy], references: [id])
  assessment      Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  indicator       RubricIndicator? @relation(fields: [indicatorId], references: [id])
  respondedByUser User?            @relation("AnsweredQuestions", fields: [respondedById], references: [id])

  @@index([assessmentId])
  @@map("assessment_questions")
}

model DepartmentRole {
  id                  String                   @id @default(dbgenerated("gen_random_uuid()"))
  departmentId        String?                  @map("department_id")
  role                AppRole
  defaultTemplateId   String?                  @map("default_template_id")
  name                String?
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @default(now()) @map("updated_at")
  approvalWorkflows   ApprovalWorkflow[]
  defaultTemplate     RubricTemplate?          @relation(fields: [defaultTemplateId], references: [id])
  department          Department?              @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  workflowAssignments RoleWorkflowAssignment[]

  @@unique([departmentId, role])
  @@index([departmentId])
  @@index([role])
  @@map("department_roles")
}

model ApprovalWorkflow {
  id               String           @id @default(dbgenerated("gen_random_uuid()"))
  departmentRoleId String           @map("department_role_id")
  stepOrder        Int              @map("step_order")
  approverRole     AppRole          @map("approver_role")
  stepType         WorkflowStepType @map("step_type")
  createdAt        DateTime         @default(now()) @map("created_at")
  departmentRole   DepartmentRole   @relation(fields: [departmentRoleId], references: [id], onDelete: Cascade)

  @@index([departmentRoleId])
  @@map("approval_workflows")
}

model WorkflowDefinition {
  id          String                   @id @default(dbgenerated("(gen_random_uuid())::text"))
  name        String
  type        TemplateType
  description String?
  createdAt   DateTime                 @default(now()) @map("created_at")
  assignments RoleWorkflowAssignment[]
  steps       WorkflowStep[]

  @@map("workflow_definitions")
}

model WorkflowStep {
  id          String             @id @default(dbgenerated("(gen_random_uuid())::text"))
  workflowId  String             @map("workflow_id")
  stepOrder   Int                @map("step_order")
  actorRole   AppRole            @map("actor_role")
  actionType  WorkflowActionType @map("action_type")
  description String?
  workflow    WorkflowDefinition @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@map("workflow_steps")
}

model RoleWorkflowAssignment {
  id               String             @id @default(dbgenerated("(gen_random_uuid())::text"))
  departmentRoleId String             @map("department_role_id")
  workflowId       String             @map("workflow_id")
  rubricId         String?            @map("rubric_id")
  isActive         Boolean            @default(true) @map("is_active")
  createdAt        DateTime           @default(now()) @map("created_at")
  departmentRole   DepartmentRole     @relation(fields: [departmentRoleId], references: [id], onDelete: Cascade, map: "role_workflow_assignments_dept_role_fkey")
  rubric           RubricTemplate?    @relation(fields: [rubricId], references: [id], map: "role_workflow_assignments_rubric_fkey")
  workflow         WorkflowDefinition @relation(fields: [workflowId], references: [id], map: "role_workflow_assignments_workflow_fkey")

  @@index([departmentRoleId], map: "role_workflow_assignments_dept_role_idx")
  @@index([rubricId], map: "role_workflow_assignments_rubric_idx")
  @@index([workflowId], map: "role_workflow_assignments_workflow_idx")
  @@map("role_workflow_assignments")
}

model Observation {
  id               String              @id @default(dbgenerated("(gen_random_uuid())::text"))
  staffId          String              @map("staffId")
  managerId        String?             @map("managerId")
  template_id      String
  status           ObservationStatus   @default(draft)
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @default(now()) @updatedAt @map("updated_at")
  submittedAt      DateTime?           @map("submitted_at")
  acknowledgedAt   DateTime?           @map("acknowledged_at")
  nlsmartrack_id   String?
  answers          ObservationAnswer[]
  updates          ObservationUpdate[]
  manager          User?               @relation("ManagerObservations", fields: [managerId], references: [id])
  rubric_templates RubricTemplate      @relation(fields: [template_id], references: [id], map: "observations_rubricId_fkey")
  staff            User                @relation("StaffObservations", fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([managerId])
  @@index([status])
  @@map("observations")
}

model ObservationAnswer {
  id              String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  observationId   String          @map("observation_id")
  indicatorId     String          @map("indicator_id")
  score           Int             @default(0)
  note            String?
  evidence        String?
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at")
  textValue       String?         @map("text_value")
  selectedOption  String?         @map("selected_option")
  selectedOptions Json?           @map("selected_options")
  indicator       RubricIndicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  observation     Observation     @relation(fields: [observationId], references: [id], onDelete: Cascade)

  @@unique([observationId, indicatorId])
  @@index([indicatorId])
  @@map("observation_answers")
}

model ObservationUpdate {
  id            String      @id @default(dbgenerated("(gen_random_uuid())::text"))
  observationId String      @map("observation_id")
  updatedById   String?     @map("updated_by_id")
  statusFrom    String?     @map("status_from")
  statusTo      String      @map("status_to")
  notes         String?
  createdAt     DateTime    @default(now()) @map("created_at")
  observation   Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  updatedBy     User?       @relation("ObservationUpdateAuthor", fields: [updatedById], references: [id])

  @@index([observationId])
  @@index([updatedById])
  @@index([createdAt])
  @@map("observation_updates")
}

model Notification {
  id           Int                @id @default(autoincrement())
  assessmentId String?            @map("assessment_id")
  userId       String?            @map("user_id")
  type         NotificationType
  status       NotificationStatus @default(pending)
  error        String?
  sentAt       DateTime?          @map("sent_at")
  createdAt    DateTime           @default(now()) @map("created_at")
  assessment   Assessment?        @relation(fields: [assessmentId], references: [id])
  user         User?              @relation(fields: [userId], references: [id])

  @@index([assessmentId])
  @@index([status])
  @@index([userId])
  @@map("notifications")
}

model NotificationPreference {
  id                     Int      @id @default(autoincrement())
  userId                 String   @unique @map("user_id")
  emailEnabled           Boolean  @default(true) @map("email_enabled")
  assessmentSubmitted    Boolean  @default(true) @map("assessment_submitted")
  managerReviewDone      Boolean  @default(true) @map("manager_review_done")
  directorApproved       Boolean  @default(true) @map("director_approved")
  adminReleased          Boolean  @default(true) @map("admin_released")
  assessmentReturned     Boolean  @default(true) @map("assessment_returned")
  assessmentAcknowledged Boolean  @default(true) @map("assessment_acknowledged")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @default(now()) @map("updated_at")
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notification_preferences")
}

model StrategicPlan {
  id           String              @id @default(dbgenerated("(gen_random_uuid())::text"))
  departmentId String              @unique @map("department_id")
  name         String
  description  String?
  vision       String?
  mission      String?
  startYear    Int                 @map("start_year")
  endYear      Int                 @map("end_year")
  status       StrategicPlanStatus @default(draft)
  ownerUserId  String?             @map("owner_user_id")
  publishedAt  DateTime?           @map("published_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @default(now()) @updatedAt @map("updated_at")
  goals        StrategicGoal[]
  periods      StrategicPeriod[]
  department   Department          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  ownerUser    User?               @relation("PlanOwner", fields: [ownerUserId], references: [id])

  @@index([status])
  @@map("strategic_plans")
}

model StrategicPeriod {
  id            String                @id @default(dbgenerated("(gen_random_uuid())::text"))
  planId        String                @map("plan_id")
  label         String
  year          Int
  sortOrder     Int                   @map("sort_order")
  budgetLines   ProgramBudgetLine[]
  periodTargets ProgramPeriodTarget[]
  plan          StrategicPlan         @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, year])
  @@unique([planId, sortOrder])
  @@index([planId])
  @@map("strategic_periods")
}

model StrategicGoal {
  id          String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  planId      String               @map("plan_id")
  number      Int
  title       String
  description String?
  sortOrder   Int                  @map("sort_order")
  plan        StrategicPlan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  objectives  StrategicObjective[]

  @@unique([planId, number])
  @@unique([planId, sortOrder])
  @@index([planId])
  @@map("strategic_goals")
}

model StrategicObjective {
  id        String             @id @default(dbgenerated("(gen_random_uuid())::text"))
  goalId    String             @map("goal_id")
  number    Int
  title     String
  sortOrder Int                @map("sort_order")
  goal      StrategicGoal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  programs  StrategicProgram[]

  @@unique([goalId, number])
  @@unique([goalId, sortOrder])
  @@index([goalId])
  @@map("strategic_objectives")
}

model StrategicProgram {
  id            String                  @id @default(dbgenerated("(gen_random_uuid())::text"))
  objectiveId   String                  @map("objective_id")
  code          String
  title         String
  description   String?
  status        ProgramStatus           @default(not_started)
  sortOrder     Int                     @map("sort_order")
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @default(now()) @updatedAt @map("updated_at")
  budgetLines   ProgramBudgetLine[]
  checklist     ProgramChecklistItem[]
  collaborators ProgramCollaborator[]
  kpiLinks      ProgramKpiLink[]
  targets       ProgramPeriodTarget[]
  updates       ProgramProgressUpdate[]
  objective     StrategicObjective      @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  @@unique([objectiveId, code])
  @@unique([objectiveId, sortOrder])
  @@index([objectiveId])
  @@map("strategic_programs")
}

model ProgramChecklistItem {
  id        String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  programId String           @map("program_id")
  text      String
  done      Boolean          @default(false)
  sortOrder Int              @map("sort_order")
  program   StrategicProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, sortOrder])
  @@index([programId])
  @@map("program_checklist_items")
}

model ProgramKpiLink {
  id            String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  programId     String           @map("program_id")
  kpiId         String           @map("kpi_id")
  coverageLabel String?          @map("coverage_label")
  kpi           Kpi              @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  program       StrategicProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, kpiId])
  @@index([programId])
  @@index([kpiId])
  @@map("program_kpi_links")
}

model ProgramPeriodTarget {
  id          String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  programId   String           @map("program_id")
  periodId    String           @map("period_id")
  targetText  String           @default("") @map("target_text")
  actualText  String?          @map("actual_text")
  status      ProgramStatus    @default(not_started)
  evidenceKey String?          @map("evidence_key")
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at")
  period      StrategicPeriod  @relation(fields: [periodId], references: [id], onDelete: Cascade)
  program     StrategicProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, periodId])
  @@index([programId])
  @@index([periodId])
  @@map("program_period_targets")
}

model ProgramCollaborator {
  id           String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  programId    String           @map("program_id")
  departmentId String           @map("department_id")
  department   Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  program      StrategicProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, departmentId])
  @@index([programId])
  @@index([departmentId])
  @@map("program_collaborators")
}

model ProgramBudgetLine {
  id          String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  programId   String           @map("program_id")
  periodId    String           @map("period_id")
  label       String
  description String?
  amountIdr   Decimal          @default(0) @map("amount_idr") @db.Decimal(15, 2)
  period      StrategicPeriod  @relation(fields: [periodId], references: [id], onDelete: Cascade)
  program     StrategicProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId])
  @@index([periodId])
  @@map("program_budget_lines")
}

model ProgramProgressUpdate {
  id        String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  programId String           @map("program_id")
  authorId  String           @map("author_id")
  note      String
  status    ProgramStatus
  createdAt DateTime         @default(now()) @map("created_at")
  author    User             @relation("ProgressUpdateAuthor", fields: [authorId], references: [id], onDelete: NoAction)
  program   StrategicProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId])
  @@index([authorId])
  @@map("program_progress_updates")
}

model migration_log {
  id          Int      @id @default(autoincrement())
  entity_type String
  source_id   String
  target_id   String
  status      String   @default("success")
  notes       String?
  migrated_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([entity_type])
  @@index([status])
}

